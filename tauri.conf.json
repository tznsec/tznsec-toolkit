{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TZNSEC Toolkit",
  "version": "1.0.0",
  "identifier": "pl.tznsec.toolkit",
  "build": {
    "frontendDist": "src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TZNSEC Toolkit",
        "width": 1180,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#06070f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "TZNSEC Toolkit - narzędzia do cyberbezpieczeństwa",
    "longDescription": "TZNSEC Toolkit - desktopowy zestaw narzędzi do cyberbezpieczeństwa i kryptografii. Napisany w Rust, interfejs HTML/CSS.",
    "publisher": "tznsec",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
